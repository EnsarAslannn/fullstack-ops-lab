# Module 3D: local development stores ConnectionStrings:Postgres in dotnet user-secrets.
# A future container environment can set the equivalent key below.
# Keep the real value outside Git; this is only a placeholder.
ConnectionStrings__Postgres=<set-outside-git>

# Module 5: set the Redis endpoint through user-secrets locally or an external env file in containers.
ConnectionStrings__Redis=<set-outside-git>
Cache__TasksTtlSeconds=60
