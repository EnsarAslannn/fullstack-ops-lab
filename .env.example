# Host development can store connection strings in dotnet user-secrets.
# These two placeholders are not used by compose.yaml.
ConnectionStrings__Postgres=<set-outside-git>
ConnectionStrings__Redis=<set-outside-git>

# Compose uses the keys below; Cache__TasksTtlSeconds is optional.
# Copy to a Git-ignored .env and run scripts/Module9.EnvPreflight.ps1 before starting services.
# For an initialized volume, these credentials must match the existing PostgreSQL role.
POSTGRES_USER=fullstackops
POSTGRES_DB=fullstackops
POSTGRES_PASSWORD=<set-outside-git>
Cache__TasksTtlSeconds=60
ASPNETCORE_ENVIRONMENT=Development

# Grafana admin credentials initialize only a new Grafana data volume.
# Keep real values in Git-ignored .env (or an explicit separate ignored env file).
# Changing these values does not rotate credentials in an initialized Grafana database.
GF_SECURITY_ADMIN_USER=<set-outside-git>
GF_SECURITY_ADMIN_PASSWORD=<set-outside-git>
