@ApiHost = http://localhost:5162
@taskId = 1

# Start the API, then run POST first. Copy its returned id to taskId if needed.
POST {{ApiHost}}/api/tasks
Content-Type: application/json

{
  "title": "Learn HTTP status codes",
  "description": "Phase 0B in-memory API"
}

###

GET {{ApiHost}}/api/tasks

###

GET {{ApiHost}}/api/tasks/{{taskId}}

###

PUT {{ApiHost}}/api/tasks/{{taskId}}
Content-Type: application/json

{
  "title": "Understand HTTP status codes",
  "description": "Updated with PUT",
  "isCompleted": true
}

###

DELETE {{ApiHost}}/api/tasks/{{taskId}}

###

# Expect 400: title must contain non-whitespace text.
POST {{ApiHost}}/api/tasks
Content-Type: application/json

{
  "title": "   "
}

###

# Expect 404: this id does not exist.
GET {{ApiHost}}/api/tasks/999999999
