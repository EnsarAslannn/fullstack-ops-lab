# Local .NET build output belongs to the host, not the Linux image.
bin/
obj/
**/bin/
**/obj/

# Repository and editor metadata are not application input.
.git/
.vs/
.vscode/
.idea/
*.user
*.suo

# Local tests, temporary files, and environment secrets.
TestResults/
**/TestResults/
*.log
*.tmp
*.bak
*~
.DS_Store
.env
.env.*

# Request samples and build instructions are not runtime files.
*.http
Dockerfile
.dockerignore
