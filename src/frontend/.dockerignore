# Local dependencies and output are rebuilt inside the image.
node_modules/
dist/
*.tsbuildinfo

# Repository and editor metadata are not build inputs.
.git/
.vs/
.vscode/
.idea/

# Local environment, logs, and temporary test output stay on the host.
.env
.env.*
*.log
npm-debug.log*
*.tmp
*.bak
*~
coverage/
playwright-report/
test-results/

# Docker reads these files, but they are not frontend source.
Dockerfile
.dockerignore
